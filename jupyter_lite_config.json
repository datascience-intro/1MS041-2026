{
  "LiteBuildConfig": {
    "contents": ["notebooks"],
    "output_dir": "lite"
  },
  "PyodideLockAddon": {
    "enabled": true,
    "specs": ["-r requirements-pyodide.txt"],
    "prefetch_extra": [
      "ipywidgets",
      "matplotlib",
      "numpy",
      "pandas",
      "plotly",
      "scikit-learn",
      "scipy",
      "sympy"
    ]
  }
}
